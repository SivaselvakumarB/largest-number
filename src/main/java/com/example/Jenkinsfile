pipeline {
    agent any

    tools {
        jdk 'JDK21'
        maven 'Maven3'
    }

    stages {
        stage('Checkout') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/SivaselvakumarB/largest-number.git'
            }
        }

        stage('Build') {
            steps {
                sh 'mvn clean compile'
            }
        }

        stage('Test') {
            steps {
                sh 'mvn test'
            }
        }

        stage('Package') {
            steps {
                sh 'mvn package'
            }
        }

        stage('Deploy') {
            steps {
                sh '''
                    mkdir -p /tmp/largest-deploy
                    cp target/largest-number-1.0.jar /tmp/largest-deploy/
                '''
            }
        }

        stage('Verify') {
            steps {
                sh '''
                    java -jar /tmp/largest-deploy/largest-number-1.0.jar
                '''
            }
        }
    }
}
